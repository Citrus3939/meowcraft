//@version=6
strategy("MACD+Stochastic + d%止损 + 2d减仓保本",
     shorttitle="MACD_Stoch_D_Stop",
     overlay=true,
     initial_capital=10000,
     default_qty_type=strategy.fixed,
     default_qty_value=1,
     pyramiding=0,
     margin_long=100,
     margin_short=100)

// ========== 1. 原策略参数 ==========
fastMAlen = input.int(12, "MACD快线")
slowMAlen = input.int(26, "MACD慢线")
signalMACDlen = input.int(9, "MACD信号线")
StochLength = input.int(14, "Stochastic长度")
OverBoughtOverSold = input.int(71, "超买线(超卖=100-此值)")
smoothK = input.int(3, "%K平滑")
smoothD = input.int(2, "%D平滑")

// ========== 2. d百分比止损/减仓参数 ==========
d_stop_pct = input.float(1.0, "d止损百分比(%)", minval=0.1, maxval=50, step=0.1, tooltip="价格反向波动超过d%止损；价格正向波动达到2d%减仓")
partial_target_multiple = 2.0

// ========== 3. 2d减仓保本参数 ==========
enable_partial_close = input.bool(true, "启用2d减仓保本")
partial_close_ratio = input.float(25.0, "减仓比例(%)", minval=1, maxval=99, step=5, tooltip="达到2d后减仓多少百分比；BTC 5分钟高盈亏比默认少减仓，让更多仓位吃后续趋势")
enable_final_take_profit = input.bool(true, "启用剩余仓位止盈")
final_take_profit_mode = input.string("RR", "剩余仓位止盈模式", options=["RR", "百分比", "较近者"], tooltip="BTC 5分钟高盈亏比默认用RR，让剩余仓位目标更远；最终止盈不会早于2d减仓价")
final_take_profit_rr = input.float(6.0, "剩余仓位止盈RR", minval=2.1, step=0.1, tooltip="R等于d%的初始风险，默认6R即约6d%")
final_take_profit_pct = input.float(10.0, "剩余仓位止盈百分比(%)", minval=0.1, maxval=100, step=0.5, tooltip="按入场均价计算的固定盈利百分比止盈")

// ========== 4. BTC 5分钟顺势过滤 ==========
enable_trend_filter = input.bool(true, "启用EMA顺势过滤", tooltip="默认开启：提高盈亏比、减少逆势抄底摸顶；关闭后恢复原MACD+Stochastic核心入场")
trend_ema_len = input.int(200, "趋势EMA长度", minval=1, tooltip="BTC 5分钟默认使用EMA200判断主趋势")
trend_slope_bars = input.int(5, "趋势斜率确认K数", minval=1, tooltip="EMA高于/低于N根前，才认为趋势方向有效")

// ========== 5. 风控过滤参数 ==========
risk_per_trade_pct = input.float(1.0, "单笔最大风险占权益(%)", minval=0.1, maxval=10, step=0.1, tooltip="按d%的止损距离反推下单数量")
max_position_pct = input.float(25.0, "最大仓位占权益(%)", minval=1, maxval=100, step=1, tooltip="限制单笔名义仓位，避免满仓或过度杠杆导致Margin Call")
min_order_qty = input.float(0.0, "最小下单数量", minval=0, step=0.0001, tooltip="计算出的仓位小于该值时跳过交易；股票可设为1，加密货币可保持0")

// ========== 计算指标 ==========
// MACD
MACD = ta.ema(close, fastMAlen) - ta.ema(close, slowMAlen)
signalMACD = ta.ema(MACD, signalMACDlen)
delta = MACD - signalMACD

// Stochastic
OverBought = OverBoughtOverSold
OverSold = 100 - OverBought
k = ta.sma(ta.stoch(close, high, low, StochLength), smoothK)
d = ta.sma(k, smoothD)

// ========== 百分比风控计算 ==========
calc_order_qty(stop_pct) =>
    stop_distance = close * stop_pct / 100
    risk_per_unit = stop_distance * syminfo.pointvalue
    unit_value = close * syminfo.pointvalue
    risk_cash = strategy.equity * risk_per_trade_pct / 100
    max_position_cash = strategy.equity * max_position_pct / 100
    qty_by_risk = risk_per_unit > 0 ? risk_cash / risk_per_unit : na
    qty_by_position_cap = unit_value > 0 ? max_position_cash / unit_value : na
    math.min(qty_by_risk, qty_by_position_cap)

calc_final_target(is_long, avg_price, risk) =>
    partial_target = is_long ? avg_price + risk * partial_target_multiple : avg_price - risk * partial_target_multiple
    rr_target = is_long ? avg_price + risk * final_take_profit_rr : avg_price - risk * final_take_profit_rr
    pct_target = is_long ? avg_price * (1 + final_take_profit_pct / 100) : avg_price * (1 - final_take_profit_pct / 100)
    selected_target = if final_take_profit_mode == "RR"
        rr_target
    else if final_take_profit_mode == "百分比"
        pct_target
    else
        is_long ? math.min(rr_target, pct_target) : math.max(rr_target, pct_target)
    is_long ? math.max(selected_target, partial_target) : math.min(selected_target, partial_target)

order_qty = calc_order_qty(d_stop_pct)

// ========== 开仓信号 ==========
trend_ema = ta.ema(close, trend_ema_len)
trend_long_ok = not enable_trend_filter or (close > trend_ema and trend_ema > trend_ema[trend_slope_bars])
trend_short_ok = not enable_trend_filter or (close < trend_ema and trend_ema < trend_ema[trend_slope_bars])

raw_long_condition = ta.crossover(k, d) and k < OverSold and ta.crossover(delta, 0)
raw_short_condition = ta.crossunder(k, d) and k > OverBought and ta.crossunder(delta, 0)
long_condition = raw_long_condition and trend_long_ok
short_condition = raw_short_condition and trend_short_ok

setup_valid = order_qty >= min_order_qty and order_qty > 0 and strategy.equity > 0

// ========== 状态变量 ==========
var float entry_price = na
var float initial_stop = na
var float partial_target_price = na
var float final_target_price = na
var bool has_partial_closed = false

// ========== 开仓执行 ==========
if long_condition and strategy.position_size == 0 and setup_valid
    has_partial_closed := false
    strategy.entry("Long", strategy.long, qty=order_qty)
else if short_condition and strategy.position_size == 0 and setup_valid
    has_partial_closed := false
    strategy.entry("Short", strategy.short, qty=order_qty)

// 持仓真正建立后，用实际成交均价计算d%止损和2d%减仓价。
// 不使用calc_on_order_fills，避免成交后在同一根历史K线内读取完整高低点造成前瞻性偏差。
new_long_position = strategy.position_size > 0 and strategy.position_size[1] <= 0
new_short_position = strategy.position_size < 0 and strategy.position_size[1] >= 0

if new_long_position
    entry_price := strategy.position_avg_price
    risk = entry_price * d_stop_pct / 100
    if risk > syminfo.mintick
        initial_stop := entry_price - risk
        partial_target_price := entry_price + risk * partial_target_multiple
        final_target_price := calc_final_target(true, entry_price, risk)
        has_partial_closed := false
    else
        strategy.close("Long", comment="无效风控")
        entry_price := na
        initial_stop := na
        partial_target_price := na
        final_target_price := na

if new_short_position
    entry_price := strategy.position_avg_price
    risk = entry_price * d_stop_pct / 100
    if risk > syminfo.mintick
        initial_stop := entry_price + risk
        partial_target_price := entry_price - risk * partial_target_multiple
        final_target_price := calc_final_target(false, entry_price, risk)
        has_partial_closed := false
    else
        strategy.close("Short", comment="无效风控")
        entry_price := na
        initial_stop := na
        partial_target_price := na
        final_target_price := na

// ========== d%止损、2d减仓、保本损 ==========
new_closed_trade = strategy.closedtrades > nz(strategy.closedtrades[1], 0)
if enable_partial_close and not has_partial_closed and new_closed_trade and strategy.position_size != 0 and not na(partial_target_price)
    last_exit_price = strategy.closedtrades.exit_price(strategy.closedtrades - 1)
    long_partial_profit = strategy.position_size > 0 and last_exit_price >= partial_target_price - syminfo.mintick
    short_partial_profit = strategy.position_size < 0 and last_exit_price <= partial_target_price + syminfo.mintick
    if long_partial_profit or short_partial_profit
        has_partial_closed := true

if strategy.position_size > 0 and not na(initial_stop) and not na(entry_price)
    if enable_partial_close and not has_partial_closed and not na(partial_target_price)
        strategy.exit("L-Partial-2D", from_entry="Long", qty_percent=partial_close_ratio, limit=partial_target_price, stop=initial_stop, comment_profit="2d减仓", comment_loss="d%止损")
        strategy.exit("L-Stop", from_entry="Long", stop=initial_stop, comment="d%止损")
    else
        strategy.cancel("L-Partial-2D")
        long_final_limit = enable_final_take_profit ? final_target_price : na
        if has_partial_closed
            strategy.exit("L-Stop", from_entry="Long", stop=entry_price, limit=long_final_limit, comment_profit="剩余止盈", comment_loss="保本损")
        else
            strategy.exit("L-Stop", from_entry="Long", stop=initial_stop, limit=long_final_limit, comment_profit="剩余止盈", comment_loss="d%止损")

if strategy.position_size < 0 and not na(initial_stop) and not na(entry_price)
    if enable_partial_close and not has_partial_closed and not na(partial_target_price)
        strategy.exit("S-Partial-2D", from_entry="Short", qty_percent=partial_close_ratio, limit=partial_target_price, stop=initial_stop, comment_profit="2d减仓", comment_loss="d%止损")
        strategy.exit("S-Stop", from_entry="Short", stop=initial_stop, comment="d%止损")
    else
        strategy.cancel("S-Partial-2D")
        short_final_limit = enable_final_take_profit ? final_target_price : na
        if has_partial_closed
            strategy.exit("S-Stop", from_entry="Short", stop=entry_price, limit=short_final_limit, comment_profit="剩余止盈", comment_loss="保本损")
        else
            strategy.exit("S-Stop", from_entry="Short", stop=initial_stop, limit=short_final_limit, comment_profit="剩余止盈", comment_loss="d%止损")

// 空仓后重置状态，避免下一笔交易沿用旧价格。
if strategy.position_size == 0 and strategy.position_size[1] != 0
    strategy.cancel("L-Partial-2D")
    strategy.cancel("S-Partial-2D")
    entry_price := na
    initial_stop := na
    partial_target_price := na
    final_target_price := na
    has_partial_closed := false

// ========== 可视化 ==========
plot(strategy.position_size > 0 ? initial_stop : na, "做多d%止损", color.red, linewidth=2, style=plot.style_linebr)
plot(strategy.position_size < 0 ? initial_stop : na, "做空d%止损", color.red, linewidth=2, style=plot.style_linebr)

plot(strategy.position_size > 0 and not has_partial_closed ? partial_target_price : na, "做多2d减仓价", color.new(color.green, 0), linewidth=1, style=plot.style_linebr)
plot(strategy.position_size < 0 and not has_partial_closed ? partial_target_price : na, "做空2d减仓价", color.new(color.green, 0), linewidth=1, style=plot.style_linebr)

plot(enable_final_take_profit and strategy.position_size > 0 ? final_target_price : na, "做多剩余止盈", color.new(color.lime, 0), linewidth=1, style=plot.style_linebr)
plot(enable_final_take_profit and strategy.position_size < 0 ? final_target_price : na, "做空剩余止盈", color.new(color.lime, 0), linewidth=1, style=plot.style_linebr)

plot(has_partial_closed and strategy.position_size != 0 ? entry_price : na, "保本线", color.new(color.yellow, 0), linewidth=2, style=plot.style_linebr)
plot(enable_trend_filter ? trend_ema : na, "EMA顺势过滤", color.new(color.orange, 0), linewidth=1)

plotshape(long_condition, title="做多信号", location=location.belowbar, style=shape.triangleup, size=size.small, color=color.new(color.green, 0))
plotshape(short_condition, title="做空信号", location=location.abovebar, style=shape.triangledown, size=size.small, color=color.new(color.red, 0))

// K线颜色（原策略）
fastMA = ta.ema(close, fastMAlen)
slowMA = ta.ema(close, slowMAlen)
veryslowMA = ta.sma(close, 100)
bartrendcolor = close > fastMA and close > slowMA and close > veryslowMA and ta.change(slowMA) > 0 ? color.green :
     close < fastMA and close < slowMA and close < veryslowMA and ta.change(slowMA) < 0 ? color.red :
     color.blue
barcolor(bartrendcolor)
